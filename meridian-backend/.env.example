# =============================================================================
# Meridian Backend — Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values.
#   cp .env.example .env
# =============================================================================

# ── Database ─────────────────────────────────────────────────────────────────
# SQLite (dev):
#   DATABASE_URL=sqlite:///./meridian.db
#
# PostgreSQL / Supabase (production):
#   Go to Supabase Dashboard → Project Settings → Database → Connection string
#   → URI. Copy the full string. It looks like:
#     postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres
DATABASE_URL=sqlite:///./meridian.db

# ── Auth (JWT) ───────────────────────────────────────────────────────────────
# Any random string, at least 32 characters. Used to sign JWT tokens.
# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
# In production this MUST be changed from the default.
SECRET_KEY=dev-secret-key-change-in-production

# ── OAuth — GitHub ───────────────────────────────────────────────────────────
# 1. Go to https://github.com/settings/developers → New OAuth App
# 2. Set Homepage URL: http://localhost:5173
# 3. Set Authorization callback URL: http://localhost:5173/auth/github/callback
# 4. Copy Client ID and generate a Client Secret
#    (or from an existing app at github.com/settings/developers)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ── OAuth — LinkedIn ─────────────────────────────────────────────────────────
# 1. Go to https://www.linkedin.com/developers/apps → Create App
# 2. Add redirect URL: http://localhost:5173/auth/linkedin/callback
# 3. Request r_emailaddress and r_liteprofile scopes
# 4. Copy Client ID and Client Secret from the Auth tab
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# ── Redis (optional, for Celery background tasks) ────────────────────────────
# Install Redis locally or use a cloud provider (Redis Labs, Upstash).
# Default is localhost on port 6379.
# REDIS_URL=redis://localhost:6379/0
# CELERY_BROKER_URL=redis://localhost:6379/0

# ── ML Model (optional) ──────────────────────────────────────────────────────
# HuggingFace sentence-transformers model for semantic feed matching.
# The default is a lightweight 80 MB model that downloads on first use.
# SENTENCE_TRANSFORMER_MODEL=all-MiniLM-L6-v2

# ── CORS / Frontend ──────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# Frontend base URL used for redirects (e.g. OAuth callbacks).
FRONTEND_URL=http://localhost:5173

# ── Environment ──────────────────────────────────────────────────────────────
# Set to "production" to enforce security checks (e.g. non-default SECRET_KEY).
# ENV=development
